{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental reference simulator request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "circuit",
    "analysis"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "backend": {
      "type": "string",
      "minLength": 1,
      "description": "Backend key resolved by the engine registry. CLI currently registers lu and qr."
    },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "elements"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "0"
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "elements": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "p",
                  "n",
                  "ohms"
                ],
                "properties": {
                  "kind": {
                    "const": "resistor"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "p": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ohms": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "p",
                  "n",
                  "farads"
                ],
                "properties": {
                  "kind": {
                    "const": "capacitor"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "p": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "farads": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "p",
                  "n",
                  "volts"
                ],
                "properties": {
                  "kind": {
                    "const": "voltage"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "p": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "volts": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "p",
                  "n",
                  "amps"
                ],
                "properties": {
                  "kind": {
                    "const": "current"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "p": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "amps": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "analysis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "operating_point"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "transient"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stop_s",
                "step_s",
                "max_steps"
              ],
              "properties": {
                "stop_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "step_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "frequencies_hz"
          ],
          "properties": {
            "kind": {
              "const": "ac"
            },
            "frequencies_hz": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    }
  }
}
