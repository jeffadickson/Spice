<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"><PrivateAssets>all</PrivateAssets></PackageReference>
    <ProjectReference Include="../Simulator.Client/Simulator.Client.csproj" />
    <ProjectReference Include="../Simulator.TransportFixture/Simulator.TransportFixture.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../Simulator.Conformance/ConformanceChecks.cs" Link="ConformanceChecks.cs" />
    <Compile Include="../Simulator.Conformance/MoreChecks.cs" Link="MoreChecks.cs" />
  </ItemGroup>
  <!-- Keep each test build's synthetic subprocess beside that immutable test
       assembly. Stryker's copied projects get their own fixture outputs. -->
  <Target Name="CopyTransportFixture" AfterTargets="Build">
    <ItemGroup><TransportFixtureFile Include="../Simulator.TransportFixture/bin/$(Configuration)/net10.0/*" /></ItemGroup>
    <Copy SourceFiles="@(TransportFixtureFile)" DestinationFolder="$(OutDir)fixture" SkipUnchangedFiles="true" />
  </Target>
</Project>
