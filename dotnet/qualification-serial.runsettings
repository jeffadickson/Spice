<RunSettings>
  <!-- Opt-in qualification on a memory-constrained shared host. This does not
       alter application concurrency or the ordinary test runner defaults. -->
  <RunConfiguration><MaxCpuCount>1</MaxCpuCount></RunConfiguration>
  <xUnit>
    <MaxParallelThreads>1</MaxParallelThreads>
    <ParallelizeTestCollections>false</ParallelizeTestCollections>
  </xUnit>
</RunSettings>
