// Independent bounded ngspice-oriented grammar; see docs/parser-only-plan.md.
// Recognition machinery is generated by ANTLR, not implemented in C#.
lexer grammar SpiceLexer;
options { caseInsensitive = true; }

// SPICE's first physical line is a title, including when it resembles a card.
TITLE: ~[\r\n]* ('\r\n' | '\r' | '\n') -> mode(BODY);
TITLE_EOF: ~[\r\n]+ -> type(TITLE), mode(BODY);

mode BODY;
CONTROL: '.control' -> pushMode(COMMAND);
MODEL: '.model';
SUBCKT: '.subckt';
ENDS: '.ends';
END: '.end';
INCLUDE: ('.include' | '.inc') -> pushMode(PATH);
PARAM: '.param';
TRAN: '.tran';
AC: '.ac';
DC: '.dc';
OP: '.op';
DIRECTIVE: '.' [a-z_] [a-z_0-9]*;
// A continuation is trivia, not a rewrite: physical offsets remain unchanged.
CONTINUATION: ('\r\n' | '\r' | '\n') [ \t]* '+' -> channel(HIDDEN);
COMMENT: {Column == 0 || InputStream.LA(-1) == '\r'}? [ \t]* '*' ~[\r\n]* -> channel(HIDDEN);
INLINE_COMMENT: ';' ~[\r\n]* -> channel(HIDDEN);
WS: [ \t\f]+ -> channel(HIDDEN);
NL: '\r\n' | '\r' | '\n';
LPAREN: '('; RPAREN: ')';
LBRACE: '{'; RBRACE: '}';
LBRACKET: '['; RBRACKET: ']';
COMMA: ','; EQUAL: '=';
PLUS: '+'; MINUS: '-'; STAR: '*'; SLASH: '/'; POWER: '**' | '^';
COMPARE: '<=' | '>=' | '==' | '!=' | '<>' | '<' | '>';
BOOL: '&&' | '||'; BANG: '!'; QUESTION: '?'; COLON: ':';
STRING: '"' ~["\r\n]* '"';
QUOTED: '\'' ~['\r\n]* '\'';
NUMBER: ([0-9]+ ('.' [0-9]*)? | '.' [0-9]+) ('e' [+-]? [0-9]+)? [a-z]*;
PASSIVE_NAME: [rcl] NAMECHAR*;
SOURCE_NAME: [vi] NAMECHAR*;
DIODE_NAME: 'd' NAMECHAR*;
BJT_NAME: 'q' NAMECHAR*;
MOS_NAME: 'm' NAMECHAR*;
JFET_NAME: [jz] NAMECHAR*;
VCONTROL_NAME: [eg] NAMECHAR*;
ICONTROL_NAME: [fh] NAMECHAR*;
SWITCH_NAME: 's' NAMECHAR*;
CSWITCH_NAME: 'w' NAMECHAR*;
COUPLING_NAME: 'k' NAMECHAR*;
SUBCALL_NAME: 'x' NAMECHAR*;
BEHAVIOR_NAME: 'b' NAMECHAR*;
LINE_NAME: [to] NAMECHAR*;
WORD: [a-z_@$#] NAMECHAR*;
fragment NAMECHAR: [a-z_0-9.!@$#%];
// Explicit invalid token prevents ANTLR's default lexer recovery from hiding input.
INVALID: .;

mode COMMAND;
ENDC: [ \t]* '.endc' [ \t]* -> popMode;
COMMAND_NL: ('\r\n' | '\r' | '\n') -> type(NL);
COMMAND_LINE: ~[\r\n]+;

// Include paths have filesystem spelling, not arithmetic tokenization. No file
// is opened. Quoted paths may contain whitespace; bare paths may not.
mode PATH;
PATH_WS: [ \t]+ -> channel(HIDDEN);
PATH_DOUBLE: '"' ~["\r\n]* '"' -> type(STRING), popMode;
PATH_SINGLE: '\'' ~['\r\n]* '\'' -> type(QUOTED), popMode;
PATH_BARE: ~[ \t\r\n"']+ -> type(WORD), popMode;
PATH_NL: ('\r\n' | '\r' | '\n') -> type(NL), popMode;
PATH_INVALID: . -> type(INVALID), popMode;
