// Independent bounded ngspice-oriented grammar; see docs/parser-only-plan.md.
// Recognition machinery is generated by ANTLR, not implemented in C#.
lexer grammar SpiceLexer;
options { caseInsensitive = true; }
@members {
    private bool digitalCard;
    /// <summary>Opt-in generated semantic header decomposition; ordinary deck recognition leaves this false.</summary>
    public bool SemanticHeaderOnly { get; set; }
}

// SPICE's first physical line is a title, including when it resembles a card.
SCRIPT_TITLE: '*ng_script' ~[\r\n]* ('\r\n' | '\r' | '\n') -> mode(SCRIPT);
TITLE: ~[\r\n]* ('\r\n' | '\r' | '\n') -> mode(BODY);
TITLE_EOF: ~[\r\n]+ -> type(TITLE), mode(BODY);

mode BODY;
CONTROL: '.control' -> pushMode(COMMAND);
MODEL: '.model';
SUBCKT: '.subckt';
ENDS: '.ends';
END: '.end';
INCLUDE: ('.include' | '.inc') -> pushMode(PATH);
PARAM: '.param';
TRAN: '.tran';
AC: '.ac';
DC: '.dc';
OP: '.op';
LIB: '.lib' -> pushMode(PATH);
// Generated lexical-mode transitions keep unbraced B/.func arithmetic apart
// from permissive SPICE node names (which may contain '-' and '/').
BEHAVIOR_START: {!SemanticHeaderOnly && (Column == 0 || InputStream.LA(-1) == '\r')}? HSPACE* 'b' NAMECHAR*
    (HSPACE+ CONNECT_UID HSPACE+ CONNECT_UID | HSPACE* '(' HSPACE* CONNECT_UID (HSPACE+ | HSPACE* ',' HSPACE*) CONNECT_UID HSPACE* ')')
    HSPACE+ [vi] HSPACE* '=' -> pushMode(EXPRESSION);
FUNC_START: {!SemanticHeaderOnly}? '.func' HSPACE+ CONNECT_UID HSPACE* '(' HSPACE*
    (CONNECT_UID (HSPACE* ',' HSPACE* CONNECT_UID)*)? HSPACE* ')' HSPACE* -> pushMode(EXPRESSION);
DIRECTIVE: '.' [a-z_] [a-z_0-9]*;
// A continuation is trivia, not a rewrite: physical offsets remain unchanged.
CONTINUATION: ('\r\n' | '\r' | '\n') ([ \t]* (('*' | DOLLAR_MARKER) ~[\r\n]*)? ('\r\n' | '\r' | '\n'))* [ \t]* '+' -> channel(HIDDEN);
CONTINUED_COMMENT: ('\r\n' | '\r' | '\n') [ \t]* '+' [ \t]* ('*' | DOLLAR_MARKER) ~[\r\n]* -> channel(HIDDEN);
COMMENT: {Column == 0 || InputStream.LA(-1) == '\r'}? [ \t]* '*' ~[\r\n]* -> channel(HIDDEN);
HASH_COMMENT: {Column == 0 || InputStream.LA(-1) == '\r'}? [ \t]* '#' ~[\r\n]* -> channel(HIDDEN);
INLINE_COMMENT: ';' ~[\r\n]* -> channel(HIDDEN);
// Reserve the PSpice global/digital namespaces; ordinary dollar text is a
// deck comment. Control/script modes keep their own variable spelling intact.
DOLLAR_COMMENT: DOLLAR_MARKER ~[\r\n]* -> channel(HIDDEN);
SLASH_COMMENT: '//' ~[\r\n]* -> channel(HIDDEN);
WS: [ \t\f]+ -> channel(HIDDEN);
// Consume failed continuation lookahead once across trivia, avoiding quadratic rescans.
NL: ('\r\n' | '\r' | '\n') ([ \t]* (('*' | DOLLAR_MARKER) ~[\r\n]*)? ('\r\n' | '\r' | '\n'))* {digitalCard=false;};
LPAREN: '('; RPAREN: ')';
LBRACE: '{' -> pushMode(EXPRESSION);
RBRACE: '}';
LBRACKET: '['; RBRACKET: ']';
COMMA: ','; EQUAL: '=';
PLUS: '+'; MINUS: '-'; STAR: '*'; SLASH: '/'; POWER: '**'; CARET: '^';
COMPARE: '<=' | '>=' | '==' | '!=' | '<>';
COMPLEX_OPEN: '<'; COMPLEX_CLOSE: '>';
AND: '&&' | '&'; OR: '||' | '|'; BANG: '!'; QUESTION: '?'; COLON: ':';
TILDE: '~';
XDIFF: '%vd' | '%id' | '%gd' | '%hd';
XSINGLE: '%vnam' | '%v' | '%i' | '%g' | '%h' | '%d';
XTYPE: '%' [a-z_] NAMECHAR*;
PERCENT: '%';
STRING: '"' ~["\r\n]* '"';
QUOTED: '\'' ~['\r\n]* '\'';
NUMBER: NUM;
NUMERIC_NAME: [0-9]+ [a-z_:] NAMECHAR*;
PASSIVE_NAME: [rcl] NAMECHAR*;
SOURCE_NAME: [vi] NAMECHAR*;
DIODE_NAME: 'd' NAMECHAR*;
BJT_NAME: 'q' NAMECHAR*;
MOS_NAME: 'm' NAMECHAR*;
JFET_NAME: [jz] NAMECHAR*;
VCONTROL_NAME: [eg] NAMECHAR*;
ICONTROL_NAME: [fh] NAMECHAR*;
SWITCH_NAME: 's' NAMECHAR*;
CSWITCH_NAME: 'w' NAMECHAR*;
COUPLING_NAME: 'k' NAMECHAR*;
SUBCALL_NAME: 'x' NAMECHAR*;
BEHAVIOR_NAME: 'b' NAMECHAR*;
LINE_NAME: [to] NAMECHAR*;
XSPICE_NAME: 'a' NAMECHAR*;
OSDI_NAME: 'n' NAMECHAR*;
CPL_NAME: 'p' NAMECHAR*;
TXL_NAME: 'y' NAMECHAR*;
// U-card Boolean expressions use PSpice leading-apostrophe logic states.
URC_DIGITAL_HEADER: {Column == 0 || InputStream.LA(-1) == '\r'}? HSPACE* 'u' NAMECHAR* LOGICAL_SPACE+ CONNECT_UID LOGICAL_SPACE* '(' LOGICAL_SPACE* NUM (LOGICAL_SPACE* ',' LOGICAL_SPACE* NUM)* LOGICAL_SPACE* ')' {digitalCard=true;};
URC_NAME: 'u' NAMECHAR*;
WORD: [a-z_@$#\u0080-\uffff] NAMECHAR*;
PATH_NAME: ('/' | '\\') [a-z_] NAMECHAR*;
fragment NAMECHAR: [a-z_0-9.!@$#%:+/\\?\u0080-\uffff-];
fragment NUM: ([0-9]+ ('.' [0-9]*)? | '.' [0-9]+) ('e' [+-]? [0-9]+)? [a-z]*;
fragment HSPACE: [ \t];
fragment LOGICAL_SPACE: HSPACE | ('\r\n' | '\r' | '\n') ([ \t]* (('*' | DOLLAR_MARKER) ~[\r\n]*)? ('\r\n' | '\r' | '\n'))* [ \t]* '+';
fragment CONNECT_UID: ~[ \t\r\n(),={}"';]+;
fragment DOLLAR_MARKER: {!((InputStream.LA(2) == 'G' || InputStream.LA(2) == 'g' || InputStream.LA(2) == 'D' || InputStream.LA(2) == 'd') && InputStream.LA(3) == '_')}? '$';
// Explicit invalid token prevents ANTLR's default lexer recovery from hiding input.
INVALID: .;

mode COMMAND;
ENDC: [ \t]* '.endc' [ \t]* -> popMode;
COMMAND_NL: ('\r\n' | '\r' | '\n') -> type(NL);
COMMAND_LINE: ~[\r\n]+;

// Include paths have filesystem spelling, not arithmetic tokenization. No file
// is opened. Quoted paths may contain whitespace; bare paths may not.
mode PATH;
PATH_WS: [ \t]+ -> channel(HIDDEN);
PATH_DOUBLE: '"' ~["\r\n]* '"' -> type(STRING), popMode;
PATH_SINGLE: '\'' ~['\r\n]* '\'' -> type(QUOTED), popMode;
PATH_BARE: ~[ \t\r\n"']+ -> type(WORD), popMode;
PATH_NL: ('\r\n' | '\r' | '\n') -> type(NL), popMode;
PATH_INVALID: . -> type(INVALID), popMode;

// Node spellings permit signs and path punctuation. Arithmetic inside braces
// uses a separate mode, so a trailing '-' cannot become a valid identifier.
mode EXPRESSION;
EXPR_LBRACE: '{' -> type(LBRACE), pushMode(EXPRESSION);
EXPR_RBRACE: '}' -> type(RBRACE), popMode;
EXPR_NUMBER: NUM -> type(NUMBER);
EXPR_NUMERIC_NAME: [0-9]+ [a-z_] [a-z_0-9.]* -> type(WORD);
// Voltage arguments are node spellings, not arithmetic operands. Keep this
// generated-mode boundary local to expressions and retain original offsets.
EXPR_VREF_OPEN: 'v' LOGICAL_SPACE* '(' -> pushMode(VOLTAGE_REFERENCE);
EXPR_WORD: [a-z_@$#\u0080-\uffff] [a-z_0-9.$#\u0080-\uffff]* -> type(WORD);
EXPR_WS: [ \t\f]+ -> channel(HIDDEN);
EXPR_COMMENT: (';' | DOLLAR_MARKER | '//') ~[\r\n]* -> channel(HIDDEN);
EXPR_CONT: ('\r\n' | '\r' | '\n') [ \t]* '+' -> channel(HIDDEN);
EXPR_NL: ('\r\n' | '\r' | '\n') -> type(NL), popMode;
EXPR_LPAREN: '(' -> type(LPAREN);
EXPR_RPAREN: ')' -> type(RPAREN);
EXPR_LBRACKET: '[' -> type(LBRACKET);
EXPR_RBRACKET: ']' -> type(RBRACKET);
EXPR_COMMA: ',' -> type(COMMA);
EXPR_POWER: ('**' | '^') -> type(POWER);
EXPR_COMPARE: ('<=' | '>=' | '==' | '!=' | '<>' | '<' | '>') -> type(COMPARE);
EXPR_EQUAL: '=' -> type(EQUAL);
EXPR_AND: ('&&' | '&') -> type(AND);
EXPR_OR: ('||' | '|') -> type(OR);
EXPR_PLUS: '+' -> type(PLUS);
EXPR_MINUS: '-' -> type(MINUS);
EXPR_STAR: '*' -> type(STAR);
EXPR_SLASH: '/' -> type(SLASH);
EXPR_PERCENT: '%' -> type(PERCENT);
EXPR_BANG: '!' -> type(BANG);
EXPR_TILDE: '~' -> type(TILDE);
EXPR_QUESTION: '?' -> type(QUESTION);
EXPR_COLON: ':' -> type(COLON);
EXPR_STRING: '"' ~["\r\n]* '"' -> type(STRING);
// PSpice logic constants use a leading apostrophe without a closing quote.
EXPR_DIGITAL: {digitalCard}? '\'' [01xzrf] -> type(NUMBER);
EXPR_QUOTED: {!digitalCard || !(InputStream.LA(2) is '0' or '1' or 'x' or 'X' or 'z' or 'Z' or 'r' or 'R' or 'f' or 'F') || !(InputStream.LA(3) is ' ' or '\t' or '\r' or '\n' or '}' or ')' or ',' or '&' or '|')}? '\'' ~['\r\n]* '\'' -> type(QUOTED);
EXPR_INVALID: . -> type(INVALID);

// A complete reference returns to the enclosing expression mode. Names reuse
// the connection spelling contract; malformed delimiters remain explicit tokens.
mode VOLTAGE_REFERENCE;
VREF_WS: [ \t\f]+ -> channel(HIDDEN);
VREF_COMMENT: (';' | DOLLAR_MARKER | '//') ~[\r\n]* -> channel(HIDDEN);
VREF_CONT: ('\r\n' | '\r' | '\n') [ \t]* '+' -> channel(HIDDEN);
VREF_NL: ('\r\n' | '\r' | '\n') -> type(NL), popMode;
VREF_COMMA: ',' -> type(COMMA);
VREF_CLOSE: ')' -> type(RPAREN), popMode;
VREF_STRING: '"' ~["\r\n]* '"' -> type(STRING);
VREF_NODE: CONNECT_UID -> type(WORD);
VREF_INVALID: . -> type(INVALID);
// ngspice inp.c explicitly selects command-file mode for *ng_script headers.
// These records are retained inert, at the same structural level as .control.
mode SCRIPT;
SCRIPT_NL: ('\r\n' | '\r' | '\n') -> type(NL);
SCRIPT_LINE: ~[\r\n]+ -> type(COMMAND_LINE);





