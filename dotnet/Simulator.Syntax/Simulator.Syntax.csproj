<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" /></ItemGroup>
  <PropertyGroup>
    <AntlrJar>$(MSBuildThisFileDirectory)../../.tools/antlr/antlr-4.13.1-complete.jar</AntlrJar>
    <GrammarOutput>$(MSBuildThisFileDirectory)obj/grammar</GrammarOutput>
    <NoWarn>$(NoWarn);CS3021</NoWarn>
  </PropertyGroup>
  <Target Name="GenerateSpiceGrammar" BeforeTargets="CoreCompile"
          Inputs="Grammar/SpiceLexer.g4;Grammar/SpiceParser.g4;$(AntlrJar)"
          Outputs="$(GrammarOutput)/SpiceLexer.cs;$(GrammarOutput)/SpiceParser.cs">
    <Error Condition="!Exists('$(AntlrJar)')" Text="Run scripts/Initialize-SyntaxParser.ps1 to acquire the pinned ANTLR generator, or set AntlrJar." />
    <GetFileHash Files="$(AntlrJar)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="AntlrGeneratorHash" />
    </GetFileHash>
    <Error Condition="'%(AntlrGeneratorHash.FileHash)' != 'BC13A9C57A8DD7D5196888211E5EDE657CB64A3CE968608697E4F668251A8487'" Text="ANTLR generator checksum mismatch." />
    <MakeDir Directories="$(GrammarOutput)" />
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)Grammar"
          Command="java -jar &quot;$(AntlrJar)&quot; -Dlanguage=CSharp -no-listener -package Simulator.Syntax.Generated -o &quot;$(GrammarOutput)&quot; SpiceLexer.g4 SpiceParser.g4" />
  </Target>
  <Target Name="IncludeSpiceGrammar" BeforeTargets="CoreCompile" DependsOnTargets="GenerateSpiceGrammar">
    <ItemGroup><Compile Include="$(GrammarOutput)/*.cs" /></ItemGroup>
  </Target>
</Project>
